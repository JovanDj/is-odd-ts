{
	"extends": [
		"@tsconfig/recommended/tsconfig.json",
		"@tsconfig/node24/tsconfig.json",
		"@tsconfig/node-ts/tsconfig.json",
		"@tsconfig/strictest/tsconfig.json"
	],
	"compilerOptions": {
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"isolatedDeclarations": true
	},
	"include": ["src"],
	"exclude": ["**/*.test.ts"]
}
